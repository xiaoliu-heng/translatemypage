{
  "name": "translatemypage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "install:host": "node scripts/install-host.mjs",
    "uninstall:host": "node scripts/install-host.mjs --uninstall",
    "package:store": "npm run build && node scripts/package-store.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.1.24",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.18.0",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.25.11",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
